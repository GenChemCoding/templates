def determine_functional_group(smiles):
  functional_groups = []
  if 'C=C' in smiles:
    functional_groups.append('alkene')
  elif 'CC#C' in smiles:
    functional_groups.append('alkyne')
  elif 'CCO' in smiles:
    functional_groups.append('alcohol')
  elif 'COC' in smiles:
    functional_groups.append('ether')
  elif 'C=O' in smiles:
    functional_groups.append('aldehyde')
  elif 'CC(=O)C' in smiles:
    functional_groups.append('ketone')
  elif 'CC(=O)O' in smiles:
    functional_groups.append('carboxylic acid')
  elif 'CC(=O)OC' in smiles:
    functional_groups.append('ester')
  elif 'CN' in smiles:
    functional_groups.append('amine')
  elif 'CC(=O)N' in smiles:
    functional_groups.append('amide')
  else:
    return 'No functional groups detected'
  return functional_groups
print(determine_functional_group(smiles))
